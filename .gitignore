node_modules/
*.log
*.tmp
.DS_Store

# Dados locais do DSH (times criados — ex.: os do DSC —, harness packs, bots, sessões).
# As equipes ficam em <botsRoot>/teams.json, fora do repositório; estas regras evitam
# que uma cópia local (DSH_HOME apontando para o projeto) seja versionada por engano.
/.dsh/
/teams.json
/teams.json.bak-*
/projects.json
/projects.json.bak-*
/harness/
/bots.json
/bots.json.bak-*
/bits.json
/bits.json.bak-*

# Artefatos de migração/quarentena e escritas atômicas dos stores de bits/times/projetos.
*.tmp-*
/bits.json.migrated-*
/bits.json.corrupt-*
/bots.json.migrated-*
/bots.json.corrupt-*
/teams.json.corrupt-*
/projects.json.corrupt-*
/team-bindings.json
/team-bindings.json.bak-*
/team-inbox/
