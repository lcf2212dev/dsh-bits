node_modules/
*.log
*.tmp
.DS_Store

# Local DSH data (created teams — e.g. the DSC ones —, harness packs, bots, sessions).
# Teams live in <botsRoot>/teams.json, outside the repository; these rules prevent a local
# copy (DSH_HOME pointing at the project) from being versioned by mistake.
/.dsh/
/teams.json
/teams.json.bak-*
/projects.json
/projects.json.bak-*
/harness/
/bots.json
/bots.json.bak-*
/bits.json
/bits.json.bak-*

# Migration/quarantine artifacts and atomic writes of the bits/teams/projects stores.
*.tmp-*
/bits.json.migrated-*
/bits.json.corrupt-*
/bots.json.migrated-*
/bots.json.corrupt-*
/teams.json.corrupt-*
/projects.json.corrupt-*
/team-bindings.json
/team-bindings.json.bak-*
/team-inbox/
